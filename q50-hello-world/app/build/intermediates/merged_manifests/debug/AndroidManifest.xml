<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest for Q50 IVI (Bosch DCU / Android 2.3 / API 10).

    Structure mirrors the working Red Sport reference app documented in:
    docs/custom-app-notes.md

    Key constraints:
    - minSdkVersion / targetSdkVersion = 10 (Dalvik 2.3)
    - Normal MAIN/LAUNCHER activity (no sharedUserId="android.uid.system")
    - IVI metadata consumed by the stock HomeScreen
    - com.ygomi.permission.IVI_CAN_READ for vehicle sensor access
    - Landscape orientation, fullscreen, no title bar
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.q50dev.hello"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="10"
        android:targetSdkVersion="10" />

    <!-- IVI permission for CAN bus data via SensorManager -->
    <uses-permission android:name="com.ygomi.permission.IVI_CAN_READ" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:label="Q50 Hello" >

        <!--
            IVI metadata — observed in the working Red Sport app.
            The stock HomeScreen reads applicationInfo.metaData and
            checks at least ivi.isDistractive.

            ivi.isDistractive  = false  → app is NOT distracting while driving
            ivi.shortcut       = true   → show shortcut in the IVI launcher
            ivi.audio          = false  → app does not use audio subsystem
            ivi.autorun        = false  → do not auto-launch on boot
            ivi.Disclaimer     = false  → no disclaimer dialog required
            ivi.supportDisplay = ALL    → runs on both upper and lower screens
            ivi.defaultDisplay = LOWER  → default to the lower touch panel
        -->
        <meta-data
            android:name="ivi.isDistractive"
            android:value="false" />
        <meta-data
            android:name="ivi.shortcut"
            android:value="true" />
        <meta-data
            android:name="ivi.audio"
            android:value="false" />
        <meta-data
            android:name="ivi.autorun"
            android:value="false" />
        <meta-data
            android:name="ivi.Disclaimer"
            android:value="false" />
        <meta-data
            android:name="ivi.supportDisplay"
            android:value="ALL" />
        <meta-data
            android:name="ivi.defaultDisplay"
            android:value="LOWER" />

        <activity
            android:name="com.q50dev.hello.MainActivity"
            android:label="Q50 Hello"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>